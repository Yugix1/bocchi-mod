		"fabric-datagen": [
			"com.yugix.datagen.BocchiDataGenerator"
		],
		"main": [
			"com.yugix.BocchiMod"
		],
		"client": [
			"com.yugix.client.BocchiModClient"
		]
	},
	"mixins": [
		"bocchi-mod.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.1",
		"java": ">=21",
